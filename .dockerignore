# Trim the build context — keeps the image small AND prevents secrets / dev
# artefacts from leaking into a layer.

# Local env (NEVER bake secrets into the image).
.env
.env.*
!.env.example

# Dependencies + build outputs (Docker rebuilds these inside the image).
node_modules
dist

# OS / IDE noise.
.DS_Store
.idea
.vscode

# Test + coverage outputs.
coverage
*.tsbuildinfo

# Local persisted state (commercial-change approval files).
uploads

# Git metadata — not needed at runtime.
.git
.gitignore
.gitattributes

# Docker artefacts themselves (avoid recursive include).
Dockerfile
.dockerignore
docker-compose*.yml

# Documentation — not needed in the image.
README.md
*.md
