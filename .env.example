# SAM backend environment template.
# Copy to .env for local dev. For production, set these in the VM's
# docker-compose env file (NEVER commit real secrets).

# ─── Database ──────────────────────────────────────────────────────────────
# Local dev: a Homebrew or Docker Postgres on localhost.
# Production:  the docker-compose 'postgres' service hostname.
DATABASE_URL="postgresql://gazon@localhost:5432/sam_dev"

# Used by Vitest. Should point at a *separate* DB so tests don't clobber dev data.
DATABASE_URL_TEST="postgresql://gazon@localhost:5432/sam_test"

# ─── Auth ──────────────────────────────────────────────────────────────────
# 32+ char random string. Generate per environment:
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_SECRET="dev-only-secret-change-me-min-32-chars-long"

# Admin user auto-created on first boot (auth-service.ts).
ADMIN_EMAIL="admin@ispcrm.com"
ADMIN_PASSWORD="123456"

# ─── CRM webhook bridge ────────────────────────────────────────────────────
# MUST match the value configured on the CRM side as SAM_WEBHOOK_SECRET.
# Use a fresh 32+ char random string in production.
CRM_WEBHOOK_SECRET="dev-only-crm-webhook-secret-change-me-32-chars-min"

# Optional: how many seconds of clock skew we accept on inbound webhooks.
# Default 300 (±5 minutes). Tighten in prod if both servers are NTP-synced.
CRM_WEBHOOK_REPLAY_SECONDS="300"

# ─── CRM service-order bridge (SAM → CRM, outbound) ───────────────────────
# Required for SAM commercial-change submissions to flow into the CRM's
# multi-stage workflow. Leave blank locally to skip the CRM call (the
# SAM-side commercial change still saves; just no order created in CRM).
CRM_API_BASE_URL="http://localhost:5001/api"
CRM_SERVICE_EMAIL=""
CRM_SERVICE_PASSWORD=""

# Kill switch — when 'true', SAM commits also create a CRM service order.
# Default off so you can deploy + smoke-test before going live.
CRM_SERVICE_ORDERS_ENABLED="false"

# ─── Server ────────────────────────────────────────────────────────────────
# Default 5500 — chosen to avoid collision with the live CRM backend on :5000.
PORT=5500
