# SAM backend — PRODUCTION environment template.
# Copy to `.env` on the VM and fill in real values. NEVER commit the real .env.
#
#   cp .env.production.example .env
#   nano .env       # fill in the secrets
#   docker compose up -d
#
# All four secrets below should be FRESH random strings, generated on-VM:
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# (or `openssl rand -hex 32` if Node isn't installed yet.)

# ─── Postgres ──────────────────────────────────────────────────────────────
# Picked up by docker-compose to provision the postgres container AND
# constructed into DATABASE_URL for the backend.
POSTGRES_PASSWORD=replace-with-a-fresh-random-string

# ─── Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-fresh-32-char-random-string

# Admin user auto-created on first boot (auth-service.ts).
# Change immediately after first login via /change-password.
ADMIN_EMAIL=admin@gazonindia.com
ADMIN_PASSWORD=replace-temporary-password-rotate-immediately

# ─── CRM webhook bridge ────────────────────────────────────────────────────
# MUST match what the CRM has set as SAM_WEBHOOK_SECRET.
# Generate fresh; do NOT reuse the dev value.
CRM_WEBHOOK_SECRET=replace-with-a-fresh-32-char-random-string

# Optional: how many seconds of clock skew accepted on inbound webhooks.
# Default 300 (±5 min). Both VM clocks should be NTP-synced regardless.
CRM_WEBHOOK_REPLAY_SECONDS=300
