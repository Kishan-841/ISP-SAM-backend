# SAM backend — PRODUCTION environment template.
# Copy to `.env` on the VM and fill in real values. NEVER commit the real .env.
#
#   cp .env.production.example .env
#   nano .env       # fill in the secrets
#   docker compose up -d
#
# All four secrets below should be FRESH random strings, generated on-VM:
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# (or `openssl rand -hex 32` if Node isn't installed yet.)

# ─── Postgres ──────────────────────────────────────────────────────────────
# Picked up by docker-compose to provision the postgres container AND
# constructed into DATABASE_URL for the backend.
POSTGRES_PASSWORD=replace-with-a-fresh-random-string

# ─── Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-fresh-32-char-random-string

# Admin user auto-created on first boot (auth-service.ts).
# Change immediately after first login via /change-password.
ADMIN_EMAIL=admin@gazonindia.com
ADMIN_PASSWORD=replace-temporary-password-rotate-immediately

# ─── CRM webhook bridge ────────────────────────────────────────────────────
# MUST match what the CRM has set as SAM_WEBHOOK_SECRET.
# Generate fresh; do NOT reuse the dev value.
CRM_WEBHOOK_SECRET=replace-with-a-fresh-32-char-random-string

# Optional: how many seconds of clock skew accepted on inbound webhooks.
# Default 300 (±5 min). Both VM clocks should be NTP-synced regardless.
CRM_WEBHOOK_REPLAY_SECONDS=300

# ─── CRM service-order bridge (SAM → CRM, outbound) ───────────────────────
# Required for the commercial-changes form to forward orders to CRM. When
# any of these are unset, the SAM-side row still saves but the CRM call is
# skipped (response includes crm.ok='disabled').
#
# Service account must be provisioned on the CRM with role SAM_HEAD or
# SAM_EXECUTIVE. Get the password securely from the CRM team — never commit.
CRM_API_BASE_URL=http://localhost:5001/api
CRM_SERVICE_EMAIL=sam-service@gazonindia.com
CRM_SERVICE_PASSWORD=replace-with-the-password-from-the-CRM-team

# Kill switch — set to 'true' to actually fire CRM service-order calls.
# Defaults to disabled so a fresh deploy doesn't fire orders before the
# operator team is ready.
CRM_SERVICE_ORDERS_ENABLED=false

# ─── Cloudinary (approval-file storage) ───────────────────────────────────
# Customer-approval PDFs / EMLs / MSGs are uploaded here. Same credentials
# as the CRM today; can be split later if needed.
CLOUDINARY_CLOUD_NAME=replace-with-cloudinary-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret
