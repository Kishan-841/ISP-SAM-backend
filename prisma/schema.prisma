generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum KittyType {
  BASE
  NEW
}

enum ContractStatus {
  ACTIVE
  EXPIRED
  TERMINATED
  PENDING
}

enum CommercialChangeType {
  UPGRADE
  DOWNGRADE
  RATE_REVISION
  TERMINATION
}

model Account {
  id              String          @id @default(uuid()) @db.Uuid
  clientName      String          @map("client_name")
  kittyType       KittyType       @map("kitty_type")
  samOwnerId      String?         @map("sam_owner_id") @db.Uuid
  currentMrr      Decimal         @map("current_mrr") @db.Decimal(12, 2)
  contractStatus  ContractStatus  @map("contract_status")
  lastMomDate     DateTime?       @map("last_mom_date") @db.Date
  lastMeetingDate DateTime?       @map("last_meeting_date") @db.Date
  onboardingDate  DateTime        @map("onboarding_date") @db.Date
  externalCrmId   String?         @unique @map("external_crm_id")
  createdAt       DateTime        @default(now()) @map("created_at")

  commercialChanges CommercialChange[]
  meetings          Meeting[]

  @@index([kittyType])
  @@index([samOwnerId])
  @@map("accounts")
}

model CommercialChange {
  id                       String                @id @default(uuid()) @db.Uuid
  accountId                String                @map("account_id") @db.Uuid
  changeType               CommercialChangeType  @map("change_type")
  oldMrr                   Decimal               @map("old_mrr") @db.Decimal(12, 2)
  newMrr                   Decimal               @map("new_mrr") @db.Decimal(12, 2)
  effectiveDate            DateTime              @map("effective_date") @db.Date
  clientApprovalAttached   Boolean               @map("client_approval_attached")
  approvalFileUrl          String?               @map("approval_file_url")
  accountsNotifiedDate     DateTime?             @map("accounts_notified_date")
  createdBy                String                @map("created_by") @db.Uuid
  createdAt                DateTime              @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId])
  @@index([effectiveDate])
  @@map("commercial_changes")
}

model Meeting {
  id           String    @id @default(uuid()) @db.Uuid
  accountId    String    @map("account_id") @db.Uuid
  meetingDate  DateTime  @map("meeting_date") @db.Date
  momSent      Boolean   @default(false) @map("mom_sent")
  momSentAt    DateTime? @map("mom_sent_at")
  createdBy    String    @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId])
  @@index([meetingDate])
  @@map("meetings")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id") @db.Uuid
  action      String
  performedBy String   @map("performed_by") @db.Uuid
  payload     Json?
  timestamp   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([performedBy])
  @@map("audit_logs")
}
