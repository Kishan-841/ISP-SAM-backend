generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum KittyType {
  BASE
  NEW
}

enum ContractStatus {
  ACTIVE
  EXPIRED
  TERMINATED
  PENDING
  /// SAM has raised a disconnection. 21-day retention window in progress —
  /// customer is *not yet* terminated; on day 21 SAM is prompted to either
  /// RETAIN or PROCEED with the disconnection.
  PROBABLE_CHURN
  /// SAM picked PROCEED on the day-21 retention prompt. 10-day window for
  /// paperwork; account is terminated on `scheduledTerminationAt`.
  DISCONNECTING
  /// SAM raised a *quick* disconnection request (skip the 21-day retention).
  /// Waiting on CRM Admin to APPROVE or REJECT. On APPROVE the account flips
  /// to DISCONNECTING with `scheduledTerminationAt = now + quickRequestedDays`
  /// (1..15). On REJECT it returns to ACTIVE.
  PENDING_QUICK_APPROVAL
  /// A BASE (existing-base) commercial change is in the internal approval
  /// chain (SUPER_ADMIN_2 → [SAM_HEAD] → ACCOUNTS). The change is NOT yet
  /// reflected on the account or the dashboard. On terminal APPROVE the
  /// account moves to its real next state (ACTIVE with new ARC / PROBABLE_CHURN
  /// / DISCONNECTING); on REJECT it returns to ACTIVE.
  PENDING_APPROVAL
}

enum RetentionDecision {
  RETAIN
  PROCEED
}

enum CommercialChangeType {
  UPGRADE
  DOWNGRADE
  RATE_REVISION
  DISCONNECTION
}

enum UserRole {
  ADMIN
  SAM_HEAD
  SAM
  /// Central accounts team. Final commercial sign-off on BASE commercial
  /// changes — they make the real change in the external billing/CRM system,
  /// then approve here to apply it to the dashboard. Org-wide.
  ACCOUNTS
  /// Second-tier super admin. First-stage sign-off on BASE disconnections
  /// (before ACCOUNTS). Org-wide.
  SUPER_ADMIN_2
}

/// Internal approval-chain state for a BASE commercial change.
/// NEW-base rows, admin backfill and bulk-import stay NOT_REQUIRED.
enum ApprovalStatus {
  /// Disconnection awaiting SUPER_ADMIN_2 (first stage).
  PENDING_SUPER_ADMIN_2
  /// Quick disconnection awaiting SAM_HEAD (middle stage, team-scoped).
  PENDING_SAM_HEAD
  /// Awaiting ACCOUNTS (final stage — applies the change on approve).
  PENDING_ACCOUNTS
  /// Fully approved and applied.
  APPROVED
  /// Rejected at some stage — terminal. rejectionReason is mandatory.
  REJECTED
  /// No approval needed (NEW base, backfill, bulk-import, legacy rows).
  NOT_REQUIRED
}

enum MeetingType {
  ONLINE
  PHYSICAL
}

model Account {
  id              String         @id @default(uuid()) @db.Uuid
  clientName      String         @map("client_name")
  kittyType       KittyType      @map("kitty_type")
  samOwnerId      String?        @map("sam_owner_id") @db.Uuid
  samOwner        User?          @relation("SamOwner", fields: [samOwnerId], references: [id], onDelete: SetNull)
  currentArc      Decimal        @map("current_arc") @db.Decimal(12, 2)
  contractStatus  ContractStatus @map("contract_status")
  /// Maintained by Phase 3 meetings.service.ts on MOM-send / meeting-create.
  lastMomDate     DateTime?      @map("last_mom_date") @db.Date
  /// Maintained by Phase 3 meetings.service.ts on meeting-create.
  lastMeetingDate DateTime?      @map("last_meeting_date") @db.Date
  onboardingDate  DateTime       @map("onboarding_date") @db.Date
  externalCrmId   String?        @unique @map("external_crm_id")
  companyName     String?         @map("company_name")
  email           String?        @map("email")
  mobileNumber    String?         @map("mobile_number")
  leadId          String?         @unique @map("lead_id")
  currentPlan     String?         @map("current_plan")
  metadata        Json?
  customerCode       String?  @unique @map("customer_code")
  circuitId          String?  @unique @map("circuit_id")
  bandwidthMbps      Int?     @map("bandwidth_mbps")
  /// Free-form installation/service address. Populated by Excel import or
  /// edited in-app. Single textarea on the UI — no structured fields.
  address            String?
  /// GSTIN — e.g. "27AAIFD5398J1ZV". 15-char Indian tax ID. Not unique:
  /// multiple sites of the same business share one GST.
  gstNumber          String?  @map("gst_number")
  /// Primary IT/operations contact at the customer (free-form text, may
  /// include role prefix + multiple names separated by newlines).
  contactPersonName  String?  @map("contact_person_name")
  /// Business segmentation, e.g. "IT", "Developers", "Manufacturing".
  industryType       String?  @map("industry_type")
  /// Geographic / network zone, e.g. "Mundhwa", "Undri".
  circle             String?
  /// Internal Gazon Account Manager — distinct from `samOwnerId`. Free-form
  /// because the CRM side doesn't share a user table with SAM yet.
  accountManager     String?  @map("account_manager")
  /// Internal slug / username for the customer connection, e.g. "dwl_undri".
  userName           String?  @map("user_name")
  /// Comma-separated list of assigned IPs (free text — we don't model them
  /// individually). Kept verbatim from the operator's spreadsheet.
  ipDetails          String?  @map("ip_details")
  startOfPeriodArc   Decimal? @map("start_of_period_arc") @db.Decimal(12, 2)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  commercialChanges CommercialChange[]
  meetings          Meeting[]

  @@index([kittyType])
  @@index([samOwnerId])
  @@map("accounts")
}

model CommercialChange {
  id                     String               @id @default(uuid()) @db.Uuid
  accountId              String               @map("account_id") @db.Uuid
  changeType             CommercialChangeType @map("change_type")
  oldArc                 Decimal              @map("old_arc") @db.Decimal(12, 2)
  newArc                 Decimal              @map("new_arc") @db.Decimal(12, 2)
  effectiveDate          DateTime             @map("effective_date") @db.Date
  clientApprovalAttached Boolean              @map("client_approval_attached")
  /// HTTPS URL to the approval file. Used to be a relative path on the SAM
  /// container's local disk (uploads/<accountId>/...). Now a Cloudinary
  /// secure_url after the storage migration.
  approvalFileUrl        String?              @map("approval_file_url")
  /// Cloudinary public_id — kept for forensic re-fetch / deletion.
  approvalFilePublicId   String?              @map("approval_file_public_id")
  /// Optional PO (Purchase Order) attachment, also in Cloudinary.
  poFileUrl              String?              @map("po_file_url")
  poFilePublicId         String?              @map("po_file_public_id")
  accountsNotifiedDate   DateTime?            @map("accounts_notified_date") @db.Timestamptz(6)
  createdBy              String               @map("created_by") @db.Uuid
  reason              String?
  oldBandwidthMbps    Int?     @map("old_bandwidth_mbps")
  newBandwidthMbps    Int?     @map("new_bandwidth_mbps")
  /// Date SAM received the customer's email approving the change. Optional
  /// in the DB so legacy rows stay valid; the form requires it for new
  /// commits and the value is forwarded to the CRM service-order.
  mailReceivedDate    DateTime? @map("mail_received_date") @db.Date

  // CRM service-order linkage. Populated after we POST /api/service-orders
  // on the CRM. Empty when the SAM-side row was created before the CRM
  // bridge existed, or when the CRM call failed and we kept the row local.
  crmServiceOrderId          String?   @unique @map("crm_service_order_id")
  crmOrderNumber             String?   @unique @map("crm_order_number")
  /// CRM enum value (PENDING_DOCS_REVIEW / PENDING_NOC / ... / COMPLETED).
  /// Stored as a free String so SAM doesn't need a migration each time
  /// the CRM workflow gains a new state.
  crmStatus                  String?   @map("crm_status")
  crmStatusUpdatedAt         DateTime? @map("crm_status_updated_at") @db.Timestamptz(6)
  /// Set during the PENDING_SAM_ACTIVATION → PENDING_ACCOUNTS transition
  /// once the SAM operator collects the billing-start date from the customer.
  activationDate             DateTime? @map("activation_date") @db.Date
  /// Set ONCE when this change is mirrored onto the account row
  /// (current_mrr / bandwidth / contract_status). Used as the idempotency
  /// marker so a re-fetch after COMPLETED doesn't double-apply.
  accountAppliedAt           DateTime? @map("account_applied_at") @db.Timestamptz(6)

  // Disconnection-specific fields. Populated only when changeType=DISCONNECTION.
  disconnectionCategoryId    String?   @map("disconnection_category_id")
  disconnectionSubCategoryId String?   @map("disconnection_sub_category_id")
  disconnectionReason        String?   @map("disconnection_reason")

  // ── Quick-disconnect workflow (DISCONNECTION rows only) ───────────────
  // SAM raises a request flagged QUICK to skip the 21-day retention. CRM
  // Admin must APPROVE before the customer is moved to DISCONNECTING.
  /// 'NORMAL' (default) or 'QUICK'. NULL for non-disconnection rows.
  disconnectionMode          String?   @map("disconnection_mode")
  /// SAM's requested time-to-terminate after CRM approval. 1..15 days.
  quickRequestedDays         Int?      @map("quick_requested_days")
  /// Mandatory free-text justification SAM provides when raising a QUICK
  /// request. Shown to CRM Admin verbatim on the approval queue.
  quickApprovalReason        String?   @map("quick_approval_reason")
  /// 'APPROVED' | 'REJECTED' | NULL (pending). Stamped by the CRM webhook
  /// when the admin decides.
  quickApprovalDecision      String?   @map("quick_approval_decision")
  quickApprovalDecidedAt     DateTime? @map("quick_approval_decided_at") @db.Timestamptz(6)
  /// Free-string CRM-side identifier (email or user id) — we don't share
  /// a user table with CRM so we don't try to FK.
  quickApprovalDecidedBy     String?   @map("quick_approval_decided_by")
  /// Optional on APPROVE, mandatory on REJECT — surfaces back to SAM.
  quickApprovalNote          String?   @map("quick_approval_note")

  // ── Probable-churn retention workflow (DISCONNECTION rows only) ───────
  // Day 0 (commit)  → retentionPromptDueAt = effectiveDate + 21d
  // Day 21          → SAM picks RETAIN or PROCEED (retentionDecision +
  //                   retentionDecidedAt stamped)
  // PROCEED only    → scheduledTerminationAt = retentionDecidedAt + 10d
  // scheduledTerminationAt → lazy sweep terminates the account
  /// When the SAM should be prompted for retain/proceed. NULL on non-disconnection rows.
  retentionPromptDueAt    DateTime?         @map("retention_prompt_due_at") @db.Date
  /// SAM's day-21 answer. NULL until decided.
  retentionDecision       RetentionDecision? @map("retention_decision")
  /// When the decision was made.
  retentionDecidedAt      DateTime?         @map("retention_decided_at") @db.Timestamptz(6)
  /// Date the account is to be fully terminated (PROCEED only).
  scheduledTerminationAt  DateTime?         @map("scheduled_termination_at") @db.Date

  // ── Internal approval chain (BASE / existing-base only) ───────────────
  // NEW-base rows, admin backfill and bulk-import stay NOT_REQUIRED and apply
  // immediately. BASE rows walk SUPER_ADMIN_2 → [SAM_HEAD] → ACCOUNTS; the
  // change is applied to the account only on the terminal APPROVED transition.
  approvalStatus         ApprovalStatus       @default(NOT_REQUIRED) @map("approval_status")
  /// Mandatory when approvalStatus=REJECTED — surfaced back to the raising SAM.
  rejectionReason        String?              @map("rejection_reason")
  /// User id of the approver who rejected. Free String vs FK to keep parity
  /// with the other decidedBy columns; we don't cascade on user delete here.
  rejectedBy             String?              @map("rejected_by") @db.Uuid
  rejectedAt             DateTime?            @map("rejected_at") @db.Timestamptz(6)
  /// User id of the approver who gave the final APPROVED sign-off, and when.
  /// Populated on the terminal approval so the Approved history tab can show
  /// who/when without joining audit_logs. Terminal stage is ACCOUNTS for
  /// non-disconnections and SUPER_ADMIN_2 for disconnections.
  approvedBy             String?              @map("approved_by") @db.Uuid
  approvedAt             DateTime?            @map("approved_at") @db.Timestamptz(6)

  /// Material-recovery outcome, captured by SUPER_ADMIN_2 on the FINAL
  /// disconnection approval. `false` (not recovered) still approves — it's
  /// recorded for follow-up, never blocking. NULL on non-disconnection rows
  /// and on anything decided before this stage existed.
  materialRecovered      Boolean?             @map("material_recovered")
  materialRecoveryNotes  String?              @map("material_recovery_notes")

  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId])
  @@index([effectiveDate])
  @@index([crmStatus])
  @@index([approvalStatus])
  @@map("commercial_changes")
}

/// SAM operator created a lead and dispatched it to CRM for assignment to
/// a BDM (Team Leader or Solo BDM). One row per dispatch attempt, regardless
/// of outcome — populates the "Leads I created" history view + audit trail.
/// CRM dedupes on `samLeadId` so a double-click on Submit doesn't create two
/// leads on their side; SAM still stamps two rows here for forensics.
model SamLeadDispatch {
  id        String   @id @default(uuid()) @db.Uuid
  /// SAM-generated UUID sent to CRM for idempotency. Unique on the dispatch
  /// table so we can detect (and short-circuit) accidental re-submits.
  samLeadId String   @unique @map("sam_lead_id") @db.Uuid

  // Form snapshot — kept on the row so the history view doesn't need CRM
  // (or doesn't need an extra CRM round-trip).
  companyName String  @map("company_name")
  contactName String  @map("contact_name")
  phone       String
  email       String?
  designation String?
  industry    String?
  city        String?
  notes       String?

  // Assignment — denormalised for display in history without re-fetching BDMs.
  assignedToUserId String @map("assigned_to_user_id")
  assignedToName   String @map("assigned_to_name")
  /// 'TEAM_LEADER' | 'SOLO_BDM' — kept as free string per the CRM contract
  /// (their enum strings could change; we just echo what they sent).
  assignedToType   String @map("assigned_to_type")

  // CRM-side response — populated on SENT, null on FAILED.
  crmLeadId     String? @map("crm_lead_id")
  crmLeadNumber String? @map("crm_lead_number")

  /// 'SENT' (CRM accepted), 'DEDUPED' (CRM saw the samLeadId before),
  /// 'FAILED' (CRM rejected — see errorReason).
  status      String
  errorReason String? @map("error_reason")

  createdBy User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdById String  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdById])
  @@index([createdAt])
  @@map("sam_lead_dispatches")
}

model Meeting {
  id                 String       @id @default(uuid()) @db.Uuid
  accountId          String       @map("account_id") @db.Uuid
  scheduledAt        DateTime     @map("scheduled_at") @db.Timestamptz(6)
  heldAt             DateTime?    @map("held_at") @db.Timestamptz(6)
  agenda             String?
  momContent         String?      @map("mom_content")
  momSentAt          DateTime?    @map("mom_sent_at") @db.Timestamptz(6)
  meetingType        MeetingType  @default(ONLINE) @map("meeting_type")
  location           String?
  /// JSON-stringified array of {name, position} — kept as TEXT to tolerate legacy comma-separated form.
  clientParticipants String?      @map("client_participants")
  gazonParticipants  String?      @map("gazon_participants")
  /// JSON array of {srNo, discussionDescription, actionOwner, planOfAction, closureDate, currentStatus}.
  actionItems        Json?        @map("action_items")
  createdBy          String       @map("created_by") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId])
  @@index([scheduledAt])
  @@map("meetings")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id") @db.Uuid
  action      String
  /// Nullable for system / unauthenticated events (LOGIN_FAILED before a
  /// session exists). Real authenticated actions always populate this.
  performedBy String?  @map("performed_by") @db.Uuid
  /// Client IP at the time of the action — sourced from X-Forwarded-For
  /// (when behind a proxy) or the socket address. Populated by
  /// `writeAudit` helper on every new entry.
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  payload     Json?
  timestamp   DateTime @default(now()) @db.Timestamptz(6)

  notificationStates NotificationState[]

  @@index([entityType, entityId])
  @@index([performedBy])
  @@map("audit_logs")
}

/// Cold storage for audit rows older than the retention window
/// (default 12 months). Same shape as `AuditLog` plus an `archivedAt`
/// timestamp. Populated by `POST /audit-logs/archive` (ADMIN). The
/// live `audit_logs` table feeds /audit + journey queries; this table
/// is only read for compliance / forensic deep-dives.
model AuditLogArchive {
  id          String   @id @db.Uuid
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id") @db.Uuid
  action      String
  performedBy String?  @map("performed_by") @db.Uuid
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  payload     Json?
  timestamp   DateTime @db.Timestamptz(6)
  archivedAt  DateTime @default(now()) @map("archived_at") @db.Timestamptz(6)

  @@index([entityType, entityId])
  @@index([performedBy])
  @@index([timestamp])
  @@map("audit_logs_archive")
}

/// Per-user overlay for the notification feed. Audit log rows are global;
/// this table records which user has read or dismissed which row. Dismissal
/// is soft — it hides the notification from that user's feed but never
/// touches the audit row itself.
model NotificationState {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  auditLogId   String    @map("audit_log_id") @db.Uuid
  readAt       DateTime? @map("read_at") @db.Timestamptz(6)
  dismissedAt  DateTime? @map("dismissed_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditLog AuditLog @relation(fields: [auditLogId], references: [id], onDelete: Cascade)

  @@unique([userId, auditLogId])
  @@index([userId, dismissedAt])
  @@index([userId, readAt])
  @@map("notification_states")
}

enum IntegrationStatus {
  PROCESSED
  DUPLICATE
  REJECTED
  FAILED
}

model IntegrationEvent {
  id              String            @id @default(uuid()) @db.Uuid
  source          String            // 'CRM' for now; future: BILLING, etc.
  eventType       String            @map("event_type")
  /// External event UUID supplied by the source — primary idempotency key.
  externalEventId String            @unique @map("external_event_id")
  occurredAt      DateTime?         @map("occurred_at") @db.Timestamptz(6)
  receivedAt      DateTime          @default(now()) @map("received_at") @db.Timestamptz(6)
  status          IntegrationStatus
  statusReason    String?           @map("status_reason")
  accountId       String?           @map("account_id") @db.Uuid
  payload         Json
  /// X-CRM-Signature header value at receive time — kept for forensics.
  signatureHeader String?           @map("signature_header")
  timestampHeader String?           @map("timestamp_header")
  remoteAddr      String?           @map("remote_addr")

  @@index([source, eventType])
  @@index([receivedAt])
  @@index([status])
  @@index([accountId])
  @@map("integration_events")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         UserRole
  samHeadId    String?  @map("sam_head_id") @db.Uuid
  samHead      User?    @relation("SamHeadHierarchy", fields: [samHeadId], references: [id], onDelete: SetNull)
  reports      User[]   @relation("SamHeadHierarchy")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Allowable churn budget for incentive calculation — net ARC churn % the
  // SAM is allowed to lose before incentive is at risk. Constrained to
  // 6.00 ≤ value ≤ 8.00 at the application layer (see users.controller.ts).
  // Stored on the User (not a global config) so SAM_HEADs can tier their
  // team. Only used when role = SAM; harmless on other roles.
  allowableChurnPercent Decimal @default(7.00) @map("allowable_churn_percent") @db.Decimal(4, 2)

  ownedAccounts      Account[]           @relation("SamOwner")
  notificationStates NotificationState[]
  samLeadDispatches  SamLeadDispatch[]
  feedbacks          Feedback[]

  @@map("users")
}

/// Public customer feedback survey submission. Filled unauthenticated via the
/// shared /feedback link. `responses` holds the full answer set keyed by
/// question id; the extracted columns exist for the Feedbacks list + filters.
model Feedback {
  id            String   @id @default(uuid()) @db.Uuid
  /// Q2 Contact Person.
  customerName  String   @map("customer_name")
  /// Q1 Company Name.
  companyName   String   @map("company_name")
  /// The "Your SAM" dropdown selection (role = SAM). Restricted delete so a
  /// SAM with feedback can't be silently removed.
  samId         String   @map("sam_id") @db.Uuid
  sam           User     @relation(fields: [samId], references: [id], onDelete: Restrict)
  /// Full answer set: { [questionId]: value }.
  responses     Json
  /// Mean of the 1–5 rating questions (Q7/Q8/Q9). Null if none answered.
  overallScore  Float?   @map("overall_score")
  /// Derived band: Very High | High | Medium | Low | Very Low. Null if no ratings.
  interestLevel String?  @map("interest_level")
  /// Q10 NPS, 0–10. Stored separately from the 1–5 average.
  npsScore      Int?     @map("nps_score")
  submittedAt   DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([samId])
  @@index([submittedAt])
  @@map("feedbacks")
}
